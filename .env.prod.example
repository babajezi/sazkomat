# Production Environment Variables for Sazkomat
# Copy this file to .env.prod and fill in the values
# Usage: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d

# =====================
# Database
# =====================
# Strong password for PostgreSQL (min 16 characters, mix of letters, numbers, special chars)
DB_PASSWORD=your_strong_database_password_here

# =====================
# JWT Authentication
# =====================
# Secret key for JWT tokens (min 64 characters, random string)
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=your_64_character_minimum_secret_key_here_generate_with_openssl_rand

# =====================
# Google OAuth (optional)
# =====================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Leave empty to disable Google login
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# =====================
# Admin Settings
# =====================
# Email of the admin user (will have access to Hangfire dashboard)
ADMIN_EMAIL=admin@example.com

# =====================
# Domain Configuration
# =====================
# Your domain (used for SSL certificate)
DOMAIN=sazkomat.herma.cz
