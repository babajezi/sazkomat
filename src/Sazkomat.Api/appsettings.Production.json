{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=sazkomat_db;Username=sazkomat;Password=${DB_PASSWORD}",
    "RedisConnection": "redis:6379"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "Sazkomat",
    "Audience": "SazkomatUsers",
    "ExpirationMinutes": 1440
  },
  "Authentication": {
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
    }
  },
  "Hangfire": {
    "WorkerCount": 3,
    "DashboardPath": "/hangfire",
    "JobExpirationDays": 14,
    "AutomaticRetryAttempts": 3,
    "EnableRecurringLiveSync": false,
    "LiveSyncCronExpression": "0 */6 * * *"
  },
  "ProviderLogo": {
    "UploadPath": "/app/uploads/provider-logos",
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".svg" ],
    "WebPQuality": 85,
    "CacheDurationDays": 30
  },
  "Scraper": {
    "BaseUrl": "https://www.betexplorer.com",
    "MinDelayMs": 3000,
    "MaxDelayMs": 7000,
    "MaxRetries": 5
  }
}
