<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <!-- Use local cache to speed up restores -->
    <add key="globalPackagesFolder" value="packages" />

    <!-- Enable parallel downloads -->
    <add key="maxHttpRequestsPerSource" value="16" />

    <!-- Optimize HTTP behavior -->
    <add key="http_proxy.bypassonlocal" value="true" />
  </config>

  <packageManagement>
    <!-- Use PackageReference format (default for SDK-style projects) -->
    <add key="format" value="1" />
  </packageManagement>
</configuration>
